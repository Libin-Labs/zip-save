{
  "name": "@lp-labs/zip-save",
  "version": "0.1.1",
  "description": "Create, read and download ZIP archives with native compression and no runtime dependencies.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "test:package": "node scripts/check-package.mjs",
    "check": "tsc --noEmit",
    "prepack": "npm run check && npm test && npm run build && npm run test:package"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "engines": { "node": ">=18" },
  "keywords": ["zip", "archive", "download", "file-saver", "compression", "browser"]
}